{
  "name": "casa-amapola-studio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "typecheck": "tsc --noEmit",
    "login": "sanity login",
    "seed": "sanity exec scripts/seed.ts --with-user-token",
